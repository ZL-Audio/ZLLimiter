if (CMAKE_HOST_APPLE)
    if (CMAKE_OSX_ARCHITECTURES MATCHES "arm64")
        set(CMAKE_OSX_DEPLOYMENT_TARGET "12" CACHE STRING "Support macOS down to macOS 12")
        message(STATUS "arm64 macOS deployment target is macOS 12")
    elseif (CMAKE_OSX_ARCHITECTURES MATCHES "x86_64")
        set(CMAKE_OSX_DEPLOYMENT_TARGET "12" CACHE STRING "Support macOS down to macOS 12")
        message(STATUS "x86-64 macOS deployment target is macOS 12")
    endif ()
    set(CMAKE_XCODE_GENERATE_SCHEME OFF)
endif ()
